[Unit]
Description=AirGate Core - AI 网关
Documentation=https://github.com/DouDOU-start/airgate-core
After=network.target postgresql.service redis.service redis-server.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=airgate
Group=airgate
# 工作目录指向数据目录：代码里的相对路径 data/uploads 会落到这里，
# 卸载删除 /opt/airgate-core 时不会连带删掉用户数据。
WorkingDirectory=/var/lib/airgate-core
ExecStart=/opt/airgate-core/airgate-core --config /etc/airgate-core/config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=airgate-core

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/airgate-core /etc/airgate-core /var/lib/airgate-core

# 进程级文件描述符限制（与 docker compose 部署对齐）
LimitNOFILE=65536

Environment=GIN_MODE=release

[Install]
WantedBy=multi-user.target
