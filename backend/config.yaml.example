server:
  host: 0.0.0.0                  # 监听地址：0.0.0.0=所有接口(局域网可达) / 127.0.0.1=仅本机
  port: 9517
  mode: release                  # debug / release

database:
  host: localhost
  port: 5432
  user: airgate
  password: ""                   # 必须修改！或设置环境变量 DB_PASSWORD
  dbname: airgate
  sslmode: disable

redis:
  host: localhost
  port: 6379
  password: ""                   # 或设置环境变量 REDIS_PASSWORD
  db: 0
  tls: false                     # 托管 Redis（如云厂商实例）常需开启；或设置环境变量 REDIS_TLS
  pool_size: 0                   # 连接池大小；0=go-redis 默认（10×CPU 核数），小核数容器高并发建议调大

jwt:
  secret: ""                     # 必须修改！或设置环境变量 JWT_SECRET
  expire_hour: 24

security:
  api_key_secret: ""             # 可选，API Key 加密密钥（hex 编码，≥64 字符）
                                 # 未配置时使用内置默认值；或设置环境变量 API_KEY_SECRET

log:
  level: "info"                  # debug / info / warn / error
                                 # 或设置环境变量 LOG_LEVEL
  format: "text"                 # text（人看）/ json（对接 Loki / ELK / Datadog）
                                 # 或设置环境变量 LOG_FORMAT

plugins:
  enabled: false                 # 无 runtime.yaml 的手工插件兼容默认值；Web 安装插件使用独立运行开关
  dir: data/plugins              # 生产插件目录：<dir>/<插件ID>/<插件ID>
  hook_timeout_ms: 500           # Relay Hook 执行链总等待时间；连续失败会熔断并自动重启插件
  dev: []                        # 开发项需显式 enabled: true，path 指向插件源码目录
